# Copy to .env and fill in. `docker compose up` reads .env automatically.

# --- Secrets that MUST NOT keep a default on a server ---
# openssl rand -hex 32
OC8_JWT_SECRET=
# Base64 of 32 random bytes. Without it the secret store fails closed.
# openssl rand -base64 32
OC8_SECRET_KEK=
# The Postgres superuser password (separate from the oc8_app/oc8_migrate roles,
# whose passwords are fixed to `oc8` by backend/docker/init-db.sql).
POSTGRES_PASSWORD=

# --- Optional ---
# `prod` (default) requires real password auth (POST /auth/setup / /auth/login)
# -- the Community welcome wizard. Set to `dev` to instead enable the
# unauthenticated dev-login endpoint and the seeded ACME/Globex demo tenants
# below -- never do this on a network-reachable instance. For a one-off local
# demo stack with both, prefer
# `docker compose -f docker-compose.yml -f docker-compose.dev.yml up` instead
# of changing this file, so the demo settings can't be copy-pasted forward
# into a real deployment's .env.
OC8_ENV=prod
# Port Caddy listens on (host side). Default 80.
OC8_HTTP_PORT=80
# Seed the ACME/Globex demo tenants on first bring-up. Only takes effect with
# OC8_ENV=dev above -- a `prod` instance has no dev-login to sign into them
# with, so leave this false unless you also set OC8_ENV=dev.
OC8_SEED_ON_START=false
# Observability: the app is OTel-instrumented but this stack ships no collector,
# so export is disabled by default. Flip to false and set the endpoint to use it.
OTEL_SDK_DISABLED=true

# --- A real agent run needs a model: EITHER a cloud key OR the `ollama` profile ---
OC8_ANTHROPIC_API_KEY=
OC8_OPENAI_API_KEY=
OC8_MISTRAL_API_KEY=
# Only relevant with `--profile ollama`; points the backend at the ollama service.
OC8_OLLAMA_BASE_URL=http://ollama:11434

# --- Container runtime (Docker by default; Podman is a drop-in alternative) ---
# `docker` (default) or `podman`. Only read by scripts/quickstart.sh/.ps1 -- it
# picks which CLI orchestrates Compose and, for podman, auto-fills
# OC8_CONTAINER_SOCKET below. Never read by the Python backend: the sandbox
# driver talks plain Docker-API-compatible REST and does not care which
# engine is listening. See
# docs/superpowers/specs/2026-08-08-podman-runtime-support-design.md.
OC8_CONTAINER_RUNTIME=docker
# Host-side path bind-mounted into the backend/worker services as their
# container-runtime socket. Leave empty for Docker's default
# (/var/run/docker.sock). scripts/quickstart.sh/.ps1 fill this in
# automatically when OC8_CONTAINER_RUNTIME=podman.
OC8_CONTAINER_SOCKET=

# --- Web Push notifications ---
# VAPID key pair for Web Push notifications. One pair per instance (not a
# tenant secret). Generate with: uv run python -m pywebpush.vapid --gen
# (from backend/), or `openssl ecparam -genkey -name prime256v1` + a base64url
# conversion. Leave both empty to disable push sending entirely (checked at
# send time, not at startup).
OC8_VAPID_PUBLIC_KEY=
OC8_VAPID_PRIVATE_KEY=
OC8_VAPID_SUBJECT=mailto:admin@example.com
